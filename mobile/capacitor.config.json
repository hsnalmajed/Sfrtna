{
  "appId": "com.sfrtna.app",
  "appName": "سفرتنا",
  "webDir": "www",
  "server": {
    "url": "https://sfrtna.com",
    "androidScheme": "https"
  },
  "android": {
    "appendUserAgent": "SfrtnaApp/Android",
    "allowMixedContent": false,
    "captureInput": false,
